# Test environment — used by jest when running npm test
# NEVER commit real credentials here.

# Use a SEPARATE MongoDB database for tests to avoid touching dev/prod data
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskorbit_test?retryWrites=true&w=majority

# Must match your development JWT_SECRET (tests need to verify tokens)
JWT_SECRET=replace_with_same_secret_as_your_main_env

JWT_EXPIRES_IN=7d
NODE_ENV=test
PORT=5001
